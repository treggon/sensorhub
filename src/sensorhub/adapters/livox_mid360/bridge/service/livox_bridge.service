[Unit]
Description=Livox MID-360 C++ Bridge (SDK2) — Aggregated window output
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/dev/treggon/sensorhub/src/sensorhub/adapters/livox_mid360/bridge/build

# --- Livox SDK2 config ---
Environment=MID360_CONFIG_PATH=/home/dev/treggon/sensorhub/config/MID360_config.json

# --- UDP emitter & control ports ---
Environment=LIVOX_UDP_PORT=18080
Environment=LIVOX_CTL_PORT=18181
Environment=LIVOX_BRIDGE_STDOUT=0

# --- Aggregation window (flush every 1.0s) ---
Environment=LIVOX_BRIDGE_AGGREGATE_SEC=1.0

# --- Aggregation window (flush every 1.0s) ---
Environment=LIVOX_BRIDGE_AGGREGATE_SEC=1.0

# --- Output format (Binary) ---
Environment=LIVOX_BRIDGE_FORMAT=bin

# (Do NOT set LIVOX_BRIDGE_FLUSH_CHUNK for binary)
#Environment=LIVOX_BRIDGE_FLUSH_CHUNK=0


# NOTE:
# - The patched bridge no longer uses multicast-related envs; they were removed.
# - Immediate (legacy) per-packet mode: omit LIVOX_BRIDGE_AGGREGATE_SEC entirely.

ExecStart=/home/dev/treggon/sensorhub/src/sensorhub/adapters/livox_mid360/bridge/build/livox_bridge

Restart=always
RestartSec=2
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
